# Rendered to /etc/nginx/conf.d/default.conf at container start by the official
# nginx entrypoint, which envsubst's ${QUOTE_SERVICE_URL} and
# ${POLICY_SERVICE_URL} (see NGINX_ENVSUBST_FILTER in the Dockerfile — it keeps
# nginx's own $uri / $host variables from being substituted).
server {
  listen 3000;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Never cache runtime config so environments can swap URLs freely.
  location = /config.js {
    add_header Cache-Control "no-store";
  }

  # Reverse proxy to the backing services. The browser only ever talks to this
  # origin, so the services can stay project-internal and need no CORS.
  # /api/quote/quotes -> ${QUOTE_SERVICE_URL}/api/v1/quotes
  location /api/quote/ {
    proxy_pass ${QUOTE_SERVICE_URL}/api/v1/;
    proxy_http_version 1.1;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # /api/policy/policies/{id}/payments -> ${POLICY_SERVICE_URL}/api/v1/policies/{id}/payments
  location /api/policy/ {
    proxy_pass ${POLICY_SERVICE_URL}/api/v1/;
    proxy_http_version 1.1;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # SPA fallback for client-side routing.
  location / {
    try_files $uri $uri/ /index.html;
  }
}
